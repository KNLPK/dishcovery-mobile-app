SPOONACULAR_API_KEY=your_spoonacular_api_key_here
PORT=3001

# Google AI Studio free tier — do NOT enable billing on that project.
GEMINI_API_KEY=your_gemini_api_key_here

# Hosted (public) mode — set by render.yaml on Render, not needed on the laptop.
# Generated-only dataset, recipe cache TTL <= 3600 s, per-IP rate limits.
# DISHCOVERY_MODE=hosted
# RECIPE_CACHE_TTL_SECONDS=3600
# RATE_LIMIT_PER_10_MIN=1200
# UPSTREAM_LIMIT_PER_10_MIN=20
# UPSTREAM_DAILY_POINTS=40
