    {
      "name": "Grain Salad Assembly",
      "steps": [
        {
          "number": 1,
          "step": "Cook pearl couscous in boiling salted water for 10 minutes until tender, then drain and transfer to a bowl."
        },
        {
          "number": 2,
          "step": "Toast pine nuts in a dry skillet over low heat for three minutes until lightly browned and fragrant."
        },
        {
          "number": 3,
          "step": "Dice the cucumber and dried apricots into small pieces and rinse the canned chickpeas thoroughly."
        },
        {
          "number": 4,
          "step": "Whisk olive oil, lemon juice, ground cumin, ground cinnamon, and salt together in a small bowl."
        },
        {
          "number": 5,
          "step": "Pour the dressing over warm couscous, tossing well so the grains absorb the aromatic spice mixture."
        },
        {
          "number": 6,
          "step": "Fold in chickpeas, cucumber, apricots, herbs, and pine nuts, then chill for 15 minutes before serving."
        }
      ]
    }
