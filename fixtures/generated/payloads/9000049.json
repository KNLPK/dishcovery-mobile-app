      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Rinse the soaked navy beans under cold running water and drain them thoroughly in a colander before starting the soup base."
        },
        {
          "number": 2,
          "step": "Heat two tablespoons of olive oil in a deep pot and cook diced onions, carrots, and celery over medium heat until softened."
        },
        {
          "number": 3,
          "step": "Stir minced garlic and tomato paste into the softened vegetables, cooking for two minutes until aromatic and slightly darkened."
        },
        {
          "number": 4,
          "step": "Add the navy beans, vegetable broth, and dried oregano to the pot, bringing the mixture to a full boil over medium-high heat."
        },
        {
          "number": 5,
          "step": "Reduce heat to low, cover the pot tightly, and simmer gently for forty minutes until the navy beans become completely tender."
        },
        {
          "number": 6,
          "step": "Remove from heat, stir in remaining olive oil, lemon juice, and chopped parsley, then cool before storing to develop flavor."
        }
      ]
    }
