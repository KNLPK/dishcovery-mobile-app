      "steps": [
        {
          "number": 1,
          "step": "Rinse pressed barley under cold water until clear, then simmer in covered water for twenty minutes until tender."
        },
        {
          "number": 2,
          "step": "Spread the cooked barley on a wide parchment tray and chill in the refrigerator until completely cold throughout."
        },
        {
          "number": 3,
          "step": "Whisk the white miso, toasted sesame oil, rice vinegar, and grated ginger together in a small bowl until smooth."
        },
        {
          "number": 4,
          "step": "Flake the hot-smoked salmon fillet into bite-sized pieces using two forks, discarding any remaining skin and bones."
        },
        {
          "number": 5,
          "step": "Combine chilled barley, edamame beans, diced cucumbers, and sliced radishes inside a deep salad mixing bowl."
        },
        {
          "number": 6,
          "step": "Pour the ginger miso dressing over the grain mixture and gently fold in the flaked smoked salmon before serving."
        }
      ]
    }
