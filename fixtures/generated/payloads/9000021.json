      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Roast whole poblano peppers over an open flame until charred, then steam in a bag, peel skin, and slice into strips."
        },
        {
          "number": 2,
          "step": "Simmer drained black beans with cumin, coriander, salt, and minced garlic in a small saucepan for ten minutes."
        },
        {
          "number": 3,
          "step": "Spread a thin layer of salsa verde across the bottom of a rectangular glass baking dish to prevent sticking."
        },
        {
          "number": 4,
          "step": "Arrange warm corn tortillas across the dish, then top with black beans, poblano strips, and oaxacan cheese."
        },
        {
          "number": 5,
          "step": "Repeat the layering process twice, finishing with a generous coating of salsa verde and crumbled cotija cheese."
        },
        {
          "number": 6,
          "step": "Bake at three hundred seventy-five degrees Fahrenheit for twenty-five minutes until cheese bubbles and browns."
        }
      ]
    }
