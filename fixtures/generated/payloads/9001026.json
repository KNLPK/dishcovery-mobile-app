  "analyzedInstructions": [
    {
      "name": "Roasting Beef",
      "steps": [
        {
          "number": 1,
          "step": "Preheat oven to 425 degrees Fahrenheit and line baking sheet with foil."
        },
        {
          "number": 2,
          "step": "Trim excess fat from beef sirloin and cut meat into half inch cubes."
        },
        {
          "number": 3,
          "step": "Toss beef cubes with vegetable oil berbere spice salt and black pepper."
        },
        {
          "number": 4,
          "step": "Spread spiced beef cubes in a single layer on prepared foil sheet."
        },
        {
          "number": 5,
          "step": "Roast beef in preheated oven for twelve minutes until browned on edges."
        },
        {
          "number": 6,
          "step": "Remove roast beef from oven and reserve all rendered pan juices in sheet."
        },
        {
          "number": 7,
          "step": "Peel red onions and chop finely into uniform small dice on board."
        },
        {
          "number": 8,
          "step": "Peel garlic cloves and mince finely alongside fresh ginger root."
        },
        {
          "number": 9,
          "step": "Melt niter kibbeh spiced butter in heavy cast iron skillet over medium."
        },
        {
          "number": 10,
          "step": "Add diced red onions to skillet and sauté ten minutes until golden."
        },
        {
          "number": 11,
          "step": "Stir minced garlic ginger cardamom and korarima into onion mixture."
        },
        {
          "number": 12,
          "step": "Add tomato paste and fry for two minutes until color turns dark red."
        },
        {
          "number": 13,
          "step": "Add diced tomatoes and cook five minutes until juices reduce completely."
        },
        {
          "number": 14,
          "step": "Pour beef broth and reserved roast beef pan juices into heavy skillet."
        }
      ]
    },
    {
      "name": "Injera Prep",
      "steps": [
        {
          "number": 1,
          "step": "Tear fresh injera sheets into bite size pieces roughly two inches wide."
        },
        {
          "number": 2,
          "step": "Spread torn injera pieces on clean baking tray to dry slightly."
        },
        {
          "number": 3,
          "step": "Place eggs in small pot of boiling water and cook for six minutes."
        },
        {
          "number": 4,
          "step": "Transfer cooked eggs into ice bath to stop cooking immediately."
        },
        {
          "number": 5,
          "step": "Peel soft boiled eggs carefully and cut in half lengthwise on board."
        },
        {
          "number": 6,
          "step": "Slice jalapeno peppers into thin round rings keeping seeds intact."
        },
        {
          "number": 7,
          "step": "Mince shallot finely and mix with cider vinegar for quick topping."
        },
        {
          "number": 8,
          "step": "Chop fresh cilantro and fresh basil leaves finely using sharp knife."
        },
        {
          "number": 9,
          "step": "Simmer skillet sauce over medium low heat until thick and glossy."
        },
        {
          "number": 10,
          "step": "Season simmered sauce with sea salt and remaining berbere spice blend."
        },
        {
          "number": 11,
          "step": "Add roasted beef cubes into simmering tomato onion sauce in skillet."
        },
        {
          "number": 12,
          "step": "Stir beef into sauce for three minutes until meat heats through."
        },
        {
          "number": 13,
          "step": "Add fresh lemon juice and fenugreek powder stirring into skillet."
        },
        {
          "number": 14,
          "step": "Ensure sauce volume is sufficient to coat dried torn injera pieces."
        }
      ]
    },
    {
      "name": "Assembly and Serving",
      "steps": [
        {
          "number": 1,
          "step": "Add torn injera pieces into skillet containing hot beef sauce mixture."
        },
        {
          "number": 2,
          "step": "Gently fold injera pieces into sauce using broad spatula to prevent tearing."
        },
        {
          "number": 3,
          "step": "Allow injera to absorb spicy berbere sauce over low heat for two minutes."
        },
        {
          "number": 4,
          "step": "Ensure every piece of injera is thoroughly coated and softened by gravy."
        },
        {
          "number": 5,
          "step": "Remove cast iron skillet from heat burner immediately after mixing."
        },
        {
          "number": 6,
          "step": "Arrange soft boiled egg halves decoratively over top of hot beef fitfit."
        },
        {
          "number": 7,
          "step": "Scatter sliced jalapeno rings evenly across warm surface of breakfast roast."
        },
        {
          "number": 8,
          "step": "Drizzle seasoned shallot vinegar mixture over eggs and beef for acidity."
        },
        {
          "number": 9,
          "step": "Sprinkle chopped cilantro and fresh basil leaves generously over dish."
        },
        {
          "number": 10,
          "step": "Dust additional korarima spice lightly over soft boiled egg halves."
        },
        {
          "number": 11,
          "step": "Portion warm breakfast roast into wide prewarmed serving bowls quickly."
        },
        {
          "number": 12,
          "step": "Ensure each portion includes roasted beef soft injera and egg half."
        },
        {
          "number": 13,
          "step": "Serve hot immediately alongside extra roll of fresh unheated injera."
        },
        {
          "number": 14,
          "step": "Pair with hot traditional Ethiopian coffee or spiced tea for breakfast."
        }
      ]
    }
  ]
