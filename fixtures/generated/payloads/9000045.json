  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Cut the sour fermented pork sausage into uniform rectangular cubes suitable for threading neatly onto wooden skewers."
        },
        {
          "number": 2,
          "step": "Soak bamboo skewers in cold water for thirty minutes to prevent them from burning on the hot open charcoal grill."
        },
        {
          "number": 3,
          "step": "Whisk palm sugar, fish sauce, ground white pepper, and minced garlic together in a bowl to create a shiny glaze."
        },
        {
          "number": 4,
          "step": "Thread alternating pieces of fermented pork, shallow-cut shallots, and bird eye chilies onto each prepared skewer."
        },
        {
          "number": 5,
          "step": "Grill skewers over glowing red coals for eight minutes, turning frequently and brushing liberally with sweet glaze."
        },
        {
          "number": 6,
          "step": "Remove skewers from heat once nicely charred, serving immediately alongside sticky rice and fresh cabbage leaves."
        }
      ]
    }
