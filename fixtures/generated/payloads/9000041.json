      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Squeeze all excess moisture from the wilted spinach using a clean kitchen towel until it feels thoroughly dry to the touch."
        },
        {
          "number": 2,
          "step": "In a medium mixing bowl, whisk together the drained spinach, whole milk ricotta, freshly grated parmesan cheese, and egg yolks."
        },
        {
          "number": 3,
          "step": "Gently fold in the all-purpose flour, sea salt, black pepper, and ground nutmeg just until a workable, pillowy dough emerges."
        },
        {
          "number": 4,
          "step": "Dust a rimmed baking sheet generously with semolina flour to prevent the delicate dumplings from sticking during shaping."
        },
        {
          "number": 5,
          "step": "Roll the dough into bite-sized balls using lightly floured hands and drop them gently into a pot of rapidly boiling salted water."
        },
        {
          "number": 6,
          "step": "Simmer the dumplings until they float gracefully to the surface, then spoon them into warm brown butter sauce for serving."
        }
      ]
    }
