  "analyzedInstructions": [
    {
      "name": "One-Pot Cooking",
      "steps": [
        {
          "number": 1,
          "step": "Heat coconut oil in a large pot, add mustard seeds, and toast until they begin to pop gently."
        },
        {
          "number": 2,
          "step": "Stir in grated ginger, turmeric, and garam masala, cooking for one minute until highly aromatic."
        },
        {
          "number": 3,
          "step": "Add yellow lentils, vegetable broth, and coconut milk, bringing the liquid to a steady simmer."
        },
        {
          "number": 4,
          "step": "Cook covered for 10 minutes until lentils soften, then stir in halved cherry tomatoes and rice vermicelli."
        },
        {
          "number": 5,
          "step": "Simmer for another four minutes until the noodles are soft and have absorbed the fragrant curried broth."
        },
        {
          "number": 6,
          "step": "Fold in baby spinach until wilted, divide into bowls, and garnish with toasted cashews before serving."
        }
      ]
    }
  ]
