      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Sauté diced red onion and minced garlic in olive oil inside a large pot over medium heat for three minutes."
        },
        {
          "number": 2,
          "step": "Add dry orzo pasta and oregano to the pot, stirring constantly for two minutes to lightly toast the grains."
        },
        {
          "number": 3,
          "step": "Pour in vegetable broth and chopped tomatoes, stirring well to combine all ingredients across the pot base."
        },
        {
          "number": 4,
          "step": "Bring to a boil, then cover and simmer over medium-low heat for ten minutes until orzo becomes perfectly tender."
        },
        {
          "number": 5,
          "step": "Fold in fresh baby spinach leaves and pitted kalamata olives until spinach wilts completely into warm pasta."
        },
        {
          "number": 6,
          "step": "Remove from heat, stir in fresh lemon juice, sprinkle with crumbled feta cheese, and serve immediately in bowls."
        }
      ]
    }
