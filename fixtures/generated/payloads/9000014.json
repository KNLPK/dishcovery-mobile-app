  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Flake the smoked trout fine and mix in a bowl with cream cheese, smoked aji amarillo, and lime zest."
        },
        {
          "number": 2,
          "step": "Add diced red pepper, sliced green onions, and chopped fresh coriander to trout mixture and stir well."
        },
        {
          "number": 3,
          "step": "Place a spoonful of trout filling in center of each dumpling wrapper and moisten edges with water."
        },
        {
          "number": 4,
          "step": "Fold wrappers over filling, crimping edges tightly to form sealed crescent dumplings without air pockets."
        },
        {
          "number": 5,
          "step": "Arrange dumplings in a bamboo steamer lined with parchment paper over boiling water for eight minutes."
        },
        {
          "number": 6,
          "step": "Combine soy sauce and sesame oil in small dip bowl, then transfer steamed dumplings to serving plate."
        }
      ]
    }
  ]
