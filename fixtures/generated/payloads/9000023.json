  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Thread sliced chicken thigh strips onto soaked bamboo skewers after marinating in coconut milk and lemongrass."
        },
        {
          "number": 2,
          "step": "Whisk peanut butter, red curry paste, coconut cream, and lime juice together over low heat to make dipping sauce."
        },
        {
          "number": 3,
          "step": "Preheat an indoor cast-iron grill pan over high heat and brush lightly with vegetable oil to prevent sticking."
        },
        {
          "number": 4,
          "step": "Grill the chicken skewers for four minutes per side until nicely charred on the outside and cooked through."
        },
        {
          "number": 5,
          "step": "Fry fresh eggs in a separate oiled skillet until whites are crisp around the edges while yolks stay soft."
        },
        {
          "number": 6,
          "step": "Plate the hot grilled skewers with warm sticky rice, fried egg, and a ramekin of warm peanut dipping sauce."
        }
      ]
    }
