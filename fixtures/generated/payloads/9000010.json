  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Cut the lamb shoulder into bite-sized cubes and toss evenly with ras el hanout spice blend and sea salt in a bowl."
        },
        {
          "number": 2,
          "step": "Heat olive oil in a heavy tagine pot over medium heat and brown the seasoned lamb pieces thoroughly on all sides."
        },
        {
          "number": 3,
          "step": "Add diced red onions to the pot and cook for six minutes until softened and translucent before pouring in broth."
        },
        {
          "number": 4,
          "step": "Add saffron threads and cinnamon stick, cover tightly, and simmer gently over low heat for sixty minutes until tender."
        },
        {
          "number": 5,
          "step": "Stir in halves of dried figs along with honey and continue simmering uncovered for fifteen minutes to thicken sauce."
        },
        {
          "number": 6,
          "step": "Garnish the rich stew with toasted blanched almonds and freshly chopped cilantro right before serving warm to guests."
        }
      ]
    }
