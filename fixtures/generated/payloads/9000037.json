  "analyzedInstructions": [
    {
      "name": "Stir Fry Assembly",
      "steps": [
        {
          "number": 1,
          "step": "Soak the thin rice vermicelli noodles in boiling water for four minutes until soft, then drain thoroughly."
        },
        {
          "number": 2,
          "step": "Heat vegetable oil in a wok over high heat and pop the mustard seeds until they sizzle and crackle softly."
        },
        {
          "number": 3,
          "step": "Add minced ginger, curry powder, and turmeric, stirring rapidly for thirty seconds to bloom aromatic spices."
        },
        {
          "number": 4,
          "step": "Toss julienned carrots and green peas into the skillet, cooking for two minutes until veggies are bright."
        },
        {
          "number": 5,
          "step": "Pour coconut milk into the pan, bringing to a quick simmer before stirring in drained noodles and salt."
        },
        {
          "number": 6,
          "step": "Divide hot spiced noodles between serving bowls and top with abundant freshly chopped cilantro before serving."
        }
      ]
    }
  ]
