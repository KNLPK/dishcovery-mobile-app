    {
      "name": "Slow Braising Phase",
      "steps": [
        {
          "number": 1,
          "step": "Heat olive oil in a heavy dutch oven over medium heat and sauté the onion and garlic until soft and fragrant."
        },
        {
          "number": 2,
          "step": "Add the squid rings to the pot and cook briefly for two minutes until opaque before pouring in dry white wine."
        },
        {
          "number": 3,
          "step": "Stir in crushed tomatoes, vegetable broth, and red pepper flakes, then bring the mixture to a gentle boil."
        },
        {
          "number": 4,
          "step": "Lower heat to a gentle simmer, cover tightly, and braise the squid for forty minutes until completely tender."
        },
        {
          "number": 5,
          "step": "Fold in the rinsed cannellini beans and cook uncovered for an additional ten minutes to thicken the broth."
        },
        {
          "number": 6,
          "step": "Season with salt, sprinkle chopped fresh parsley on top, and serve warm in deep rimmed pasta bowls immediately."
        }
      ]
    }
