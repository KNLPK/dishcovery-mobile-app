  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Mash the fermented black garlic cloves into a smooth paste using a heavy mortar and pestle until fully emulsified."
        },
        {
          "number": 2,
          "step": "Whisk together the whole milk ricotta, grated parmesan, egg yolks, and ground nutmeg in a large chilled glass bowl."
        },
        {
          "number": 3,
          "step": "Fold fine semolina into the cheese base gently, shaping small rounded dumplings filled with a pinch of garlic paste."
        },
        {
          "number": 4,
          "step": "Roll the formed dumplings in extra semolina flour and let them chill in the refrigerator for two hours to firm up."
        },
        {
          "number": 5,
          "step": "Gently drop the chilled dumplings into a wide pot of salted water kept at a bare simmer for four minutes until floating."
        },
        {
          "number": 6,
          "step": "Melt butter with fresh sage leaves in a pan, then spoon the fragrant warm butter over drained dumplings immediately."
        }
      ]
    }
  ]
