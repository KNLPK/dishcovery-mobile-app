  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Finely mince fresh lemongrass stalks, garlic cloves, and shallots using a sharp knife on a cutting board."
        },
        {
          "number": 2,
          "step": "Combine fish sauce, lime juice, brown sugar, and vegetable oil with the minced aromatics in a wide bowl."
        },
        {
          "number": 3,
          "step": "Thread peeled jumbo shrimp onto soaked wooden skewers, leaving small gaps between each piece for heat flow."
        },
        {
          "number": 4,
          "step": "Brush the flavorful lemongrass marinade generously over all sides of the prepped seafood skewers."
        },
        {
          "number": 5,
          "step": "Grill the skewers over medium-high heat for three minutes per side until the shrimp turn opaque and pink."
        },
        {
          "number": 6,
          "step": "Garnish the cooked skewers with chopped roasted peanuts and fresh cilantro leaves before serving warm."
        }
      ]
    }
