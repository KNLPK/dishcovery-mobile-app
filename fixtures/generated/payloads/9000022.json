  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Heat coconut oil in a clay soup pot and pop black mustard seeds until they crackle and release their fragrance."
        },
        {
          "number": 2,
          "step": "Sauté sliced shallots, minced ginger, garlic, and torn curry leaves until light golden brown and aromatic."
        },
        {
          "number": 3,
          "step": "Stir in turmeric powder, coriander, Kashmiri chili powder, and tamarind paste, cooking spices for one minute."
        },
        {
          "number": 4,
          "step": "Pour in unsweetened coconut milk along with fish stock, bringing the fragrant golden liquid to a soft simmer."
        },
        {
          "number": 5,
          "step": "Add peeled wild prawns into the simmering coconut broth and cook gently for four minutes until pink and cooked."
        },
        {
          "number": 6,
          "step": "Ladle the hot prawn soup into shallow bowls and garnish with fresh lime juice and torn coriander leaves."
        }
      ]
    }
  ]
