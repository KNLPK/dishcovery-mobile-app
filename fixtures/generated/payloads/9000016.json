      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Slice potatoes thinly and boil in salted water for eight minutes until slightly tender, then drain well."
        },
        {
          "number": 2,
          "step": "Melt niter kibbeh in a skillet and sauté sliced red onions and garlic with berbere spice for five minutes."
        },
        {
          "number": 3,
          "step": "Stir tomato paste and vegetable broth into onion spice mixture to form a fragrant thick sauce."
        },
        {
          "number": 4,
          "step": "Coat tilapia fillets with fresh lemon juice and season lightly on both sides with salt and berbere spice."
        },
        {
          "number": 5,
          "step": "Layer half the potatoes in a greased baking dish, top with fish fillets, sauce, and remaining potatoes."
        },
        {
          "number": 6,
          "step": "Bake in oven at three hundred seventy-five degrees Fahrenheit for twenty-five minutes, garnish with cilantro."
        }
      ]
    }
