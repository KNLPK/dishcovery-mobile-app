  "analyzedInstructions": [
    {
      "name": "Pear Braise",
      "steps": [
        {
          "number": 1,
          "step": "Peel whole Bosc pears carefully while keeping stems intact, slicing a flat base on the bottom of each fruit."
        },
        {
          "number": 2,
          "step": "Combine red wine, sugar, cinnamon sticks, star anise, orange peel, and cocoa powder in a heavy dutch oven."
        }
      ]
    },
    {
      "name": "Sauce Reduction",
      "steps": [
        {
          "number": 1,
          "step": "Submerge pears in the spiced red wine mixture, cover tightly, and braise at three hundred degrees for one hour."
        },
        {
          "number": 2,
          "step": "Transfer cooked pears to plates, then boil the braising liquid until reduced to a thick chocolate red wine glaze."
        }
      ]
    }
