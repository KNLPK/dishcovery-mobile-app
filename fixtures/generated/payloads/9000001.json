  "analyzedInstructions": [
    {
      "name": "Braising",
      "steps": [
        {
          "number": 1,
          "step": "Pat the beef chuck dry with paper towels, cut into bite-sized cubes, and season evenly with salt and black pepper."
        },
        {
          "number": 2,
          "step": "Heat the olive oil in a heavy skillet over medium-high heat and sear the beef cubes until golden brown on all sides."
        },
        {
          "number": 3,
          "step": "Remove the beef, then add chopped onion and garlic to the pan, cooking until softened and fragrant for three minutes."
        },
        {
          "number": 4,
          "step": "Stir in tomato paste and cook for one minute, then pour in red wine to deglaze the skillet while scraping the bottom."
        },
        {
          "number": 5,
          "step": "Return the beef to the skillet, add tomatoes, broth, and fresh rosemary, then cover and simmer over low heat for 30 minutes."
        },
        {
          "number": 6,
          "step": "Remove from heat, discard the rosemary sprig, stir in chopped fresh parsley, and serve hot over cooked polenta."
        }
      ]
    }
  ]
