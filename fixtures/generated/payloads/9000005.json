  "analyzedInstructions": [
    {
      "name": "Griddling and Dip Assembly",
      "steps": [
        {
          "number": 1,
          "step": "Mix wheat flour with warm water and oil, knead into a smooth dough, and divide into four equal portions."
        },
        {
          "number": 2,
          "step": "Roll each dough ball into a thin round flatbread on a lightly oiled wooden surface using a rolling pin."
        },
        {
          "number": 3,
          "step": "Finely chop lemongrass, garlic, and red chili, then sauté in oil inside a pan until fragrant."
        },
        {
          "number": 4,
          "step": "Stir in fermented soybean paste, coconut cream, and palm sugar, simmering for five minutes until thick."
        },
        {
          "number": 5,
          "step": "Cook each flatbread in a hot skillet for two minutes per side until golden brown bubbles form."
        },
        {
          "number": 6,
          "step": "Finish the warm fermented dip with lime juice, garnish with basil and peanuts, and serve beside flatbreads."
        }
      ]
    }
