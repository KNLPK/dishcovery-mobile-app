      "steps": [
        {
          "number": 1,
          "step": "Season beef chuck cubes with salt, cumin, and black pepper before searing in oil inside a Dutch oven."
        },
        {
          "number": 2,
          "step": "Blend fresh cilantro leaves, yellow paste, garlic, and beef broth into a smooth green herb puree."
        },
        {
          "number": 3,
          "step": "Pour cilantro puree over seared beef, cover tightly, and braise on low heat for seventy-five minutes."
        },
        {
          "number": 4,
          "step": "Pan-fry diced sweet potatoes in a separate skillet until golden and crisp around the outer edges."
        },
        {
          "number": 5,
          "step": "Shred the tender braised beef into small pieces and spoon over a bed of warm crispy sweet potatoes."
        },
        {
          "number": 6,
          "step": "Top each serving bowl with a freshly fried sunny-side-up egg and sliced red onion salsa criolla."
        }
      ]
