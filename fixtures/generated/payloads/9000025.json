      "steps": [
        {
          "number": 1,
          "step": "Pour hot vegetable broth over dry couscous in a heatproof bowl, then cover tightly with plate for ten minutes."
        },
        {
          "number": 2,
          "step": "Finely dice the preserved lemon peel, removing all seeds and pulp before adding it to a small mixing vessel."
        },
        {
          "number": 3,
          "step": "Whisk olive oil, ground cumin, sea salt, and fresh lemon juice together until emulsified into a fragrant dressing."
        },
        {
          "number": 4,
          "step": "Fluff the warm cooked couscous using a fork, then toss in diced cucumbers, quartered cherry tomatoes, and mint."
        },
        {
          "number": 5,
          "step": "Drizzle the prepared dressing evenly across the grain salad, stirring gently to ensure everything is coated."
        },
        {
          "number": 6,
          "step": "Scatter toasted pine nuts and chopped parsley over the top right before serving at cool room temperature."
        }
      ]
    }
