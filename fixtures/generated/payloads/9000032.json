      "steps": [
        {
          "number": 1,
          "step": "Boil fresh Polish kluski egg noodles in a large pot of salted water until tender, then drain thoroughly."
        },
        {
          "number": 2,
          "step": "Sauté sliced wild porcini mushrooms and diced shallots in butter until caramelized and fragrant."
        },
        {
          "number": 3,
          "step": "Add shredded roasted duck meat to the skillet, stirring to warm through and absorb mushroom juices."
        },
        {
          "number": 4,
          "step": "Pour heavy cream and beef broth into the skillet, bringing the pan contents to a gentle simmer."
        },
        {
          "number": 5,
          "step": "Toss cooked kluski noodles into the cream sauce, folding everything together until evenly coated."
        },
        {
          "number": 6,
          "step": "Divide noodle mixture into wide bowls and garnish generously with chopped fresh dill and black pepper."
        }
      ]
