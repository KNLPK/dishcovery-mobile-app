  "analyzedInstructions": [
    {
      "name": "Preparation and Roasting",
      "steps": [
        {
          "number": 1,
          "step": "Whisk achiote paste, orange juice, lime juice, minced garlic, oregano, cumin, and olive oil into a smooth paste."
        },
        {
          "number": 2,
          "step": "Rub the marinade thoroughly over the pork loin and chill in a covered container for at least four hours."
        },
        {
          "number": 3,
          "step": "Preheat your oven to 190 degrees Celsius and transfer the marinated pork to a shallow roasting pan."
        },
        {
          "number": 4,
          "step": "Pour chicken broth into the bottom of the pan to keep the meat moist and roast for 45 to 50 minutes."
        },
        {
          "number": 5,
          "step": "Remove the roast from the oven, let it rest for 10 minutes, then slice thinly and transfer to a storage dish."
        },
        {
          "number": 6,
          "step": "Pour the pan drippings over the slices to store ahead, or serve immediately with sliced red onion and cilantro."
        }
      ]
    }
  ]
