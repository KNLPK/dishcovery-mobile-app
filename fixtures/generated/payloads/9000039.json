  "analyzedInstructions": [
    {
      "name": "Dumpling Preparation",
      "steps": [
        {
          "number": 1,
          "step": "Drain ricotta in cheesecloth for twenty minutes to remove excess whey, creating a dense base for dough."
        },
        {
          "number": 2,
          "step": "Mix drained ricotta, parmesan, egg yolks, herbs, lemon zest, nutmeg, salt, and pepper in a medium bowl."
        },
        {
          "number": 3,
          "step": "Gently fold in flour until a soft pliable dough forms, taking care not to overmix the delicate dough."
        },
        {
          "number": 4,
          "step": "Shape dough into small oval dumplings, place on a lined baking tray, and chill in the fridge for two hours."
        },
        {
          "number": 5,
          "step": "Poach dumplings in gently simmering salted water for three minutes until they float smoothly to the surface."
        },
        {
          "number": 6,
          "step": "Transfer dumplings with a slotted spoon directly into warm melted butter and toss gently before serving."
        }
      ]
    }
  ]
