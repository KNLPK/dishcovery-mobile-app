  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Char the poblano peppers directly over open gas flames until skin turns blackened and blistered on all sides before steaming."
        },
        {
          "number": 2,
          "step": "Peel away the charred skins, remove seeds, and slice the roasted peppers into thin strips along with yellow onion slices."
        },
        {
          "number": 3,
          "step": "Sauté the sliced onions and garlic in vegetable oil until soft, then stir in black beans, Mexican oregano, and sea salt."
        },
        {
          "number": 4,
          "step": "Lightly fry corn tortilla quarters in warm oil for ten seconds each to prevent them from becoming soggy inside the casserole."
        },
        {
          "number": 5,
          "step": "Layer the tortillas, spiced bean mixture, roasted poblano strips, salsa verde, and shredded Oaxaca cheese inside a ceramic dish."
        },
        {
          "number": 6,
          "step": "Cover the dish tightly with foil and chill overnight, then bake at high heat until the cheese bubbles and turns golden brown."
        }
      ]
    }
  ]
