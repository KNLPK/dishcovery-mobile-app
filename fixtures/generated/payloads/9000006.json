  "analyzedInstructions": [
    {
      "name": "Dumpling Preparation and Poaching",
      "steps": [
        {
          "number": 1,
          "step": "Melt half the butter with milk in a saucepan, stir in flour, and cook until dough forms a smooth ball."
        },
        {
          "number": 2,
          "step": "Remove from heat, beat in eggs one at a time, then fold in finely flaked smoked trout and nutmeg."
        },
        {
          "number": 3,
          "step": "Shape the mixture into oval quenelles using two wet tablespoons and set them on a parchment sheet."
        },
        {
          "number": 4,
          "step": "Gently drop quenelles into a wide pan of simmering salted water, poaching for six minutes until puffed."
        },
        {
          "number": 5,
          "step": "In another saucepan, simmer fish stock and white wine, then whisk in remaining butter and heavy cream."
        },
        {
          "number": 6,
          "step": "Transfer poached dumplings to warm bowls, spoon over the chive butter broth, and drizzle with lemon juice."
        }
      ]
    }
  ]
