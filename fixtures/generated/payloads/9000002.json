  "analyzedInstructions": [
    {
      "name": "Stewing",
      "steps": [
        {
          "number": 1,
          "step": "Score the skin of the duck breast in a crosshatch pattern and cut into thick, bite-sized diagonal slices."
        },
        {
          "number": 2,
          "step": "Peel the taro, lotus root, and carrot, then slice them into decorative shapes for a celebratory presentation."
        },
        {
          "number": 3,
          "step": "Heat a dry skillet over medium heat and lightly sear the duck slices skin-side down until fat renders out."
        },
        {
          "number": 4,
          "step": "Bring dashi stock, mirin, soy sauce, sake, and minced ginger to a gentle simmer in a large clay pot."
        },
        {
          "number": 5,
          "step": "Add the root vegetables and shiitake mushrooms to the broth, covering to simmer on low heat for 20 minutes."
        },
        {
          "number": 6,
          "step": "Skim off excess fat, add the seared duck and snow peas, and cook for another five minutes before serving warm."
        }
      ]
    }
