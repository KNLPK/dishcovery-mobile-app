  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Boil the egg kluski noodles in well-salted water until tender, then drain thoroughly and toss with a drop of rapeseed oil."
        },
        {
          "number": 2,
          "step": "Melt the unsalted butter in a thick-bottomed skillet over medium flame until it bubbles gently without browning."
        },
        {
          "number": 3,
          "step": "Sauté the sliced sweet onions and shredded green cabbage together for twelve minutes until softly translucent and brown."
        },
        {
          "number": 4,
          "step": "Add the sliced sausage along with dried marjoram, salt, and cracked black pepper, stirring continuously for five minutes."
        },
        {
          "number": 5,
          "step": "Fold the cooked noodles into the cabbage mix, drizzling apple cider vinegar to combine all ingredients evenly."
        },
        {
          "number": 6,
          "step": "Transfer the assembled noodle mixture into airtight glass containers and chill overnight before reheating to serve."
        }
      ]
    }
