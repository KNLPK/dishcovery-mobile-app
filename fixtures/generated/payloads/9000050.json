  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Combine ground pork, minced lemongrass, shallots, garlic, fish sauce, sugar, and pepper in a bowl, mixing until sticky."
        },
        {
          "number": 2,
          "step": "Divide the pork mixture into eight equal portions and mold each tightly around a soaked bamboo skewer into a firm log shape."
        },
        {
          "number": 3,
          "step": "Heat vegetable oil over medium-high heat in a large heavy pot or Dutch oven until shimmering across the entire surface."
        },
        {
          "number": 4,
          "step": "Arrange the prepared skewers in a single layer inside the hot pot, working in batches if necessary to avoid overcrowding."
        },
        {
          "number": 5,
          "step": "Sear the skewers for six minutes, turning occasionally until a rich golden-brown crust develops evenly on all sides."
        },
        {
          "number": 6,
          "step": "Pour coconut water into the pot bottom, cover tightly, and simmer three minutes until pork is cooked through and glazed."
        }
      ]
    }
