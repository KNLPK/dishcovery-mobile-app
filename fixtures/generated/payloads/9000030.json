      "steps": [
        {
          "number": 1,
          "step": "Peel and cut fresh sugar pumpkin into uniform bite-sized cubes using a sharp chef knife."
        },
        {
          "number": 2,
          "step": "Combine water, granulated sugar, cinnamon sticks, and whole cloves in a wide saucepan over heat."
        },
        {
          "number": 3,
          "step": "Add the pumpkin cubes to the bubbling spiced syrup, covering the pan to cook gently for twenty minutes."
        },
        {
          "number": 4,
          "step": "Stir orange blossom water and lemon juice into the stew once the pumpkin becomes soft and translucent."
        },
        {
          "number": 5,
          "step": "Remove saucepan from heat and allow the dessert stew to cool to room temperature in its syrup."
        },
        {
          "number": 6,
          "step": "Spoon cooked pumpkin into small dessert bowls, topping with clotted cream and toasted pine nuts."
        }
      ]
    }
