  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Rinse the pearl barley under cold running water until the liquid runs completely clear, then drain well in a fine mesh sieve."
        },
        {
          "number": 2,
          "step": "Cook the washed grain in salted boiling water until tender yet chewy, then spread it across a large sheet pan to cool completely."
        },
        {
          "number": 3,
          "step": "Toss diced kabocha squash with toasted sesame oil and roast at high heat until caramelization develops around the crisp edges."
        },
        {
          "number": 4,
          "step": "Whisk yuzu juice, soy sauce, rice vinegar, grated ginger, and mirin in a small ceramic glass jar to form a bright dressing."
        },
        {
          "number": 5,
          "step": "Combine the cooled barley, roasted squash cubes, sliced edamame, and toasted lotus root chips in a large decorative wooden bowl."
        },
        {
          "number": 6,
          "step": "Pour the citrusy dressing over the salad components, toss thoroughly to coat, and garnish generously with toasted sesame seeds."
        }
      ]
    }
