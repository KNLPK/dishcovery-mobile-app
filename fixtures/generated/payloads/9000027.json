      "steps": [
        {
          "number": 1,
          "step": "Rinse brown lentils under cold running water in a mesh strainer, removing any debris before cooking."
        },
        {
          "number": 2,
          "step": "Sauté chopped yellow onion, diced carrots, and minced celery in olive oil inside a heavy pot for seven minutes."
        },
        {
          "number": 3,
          "step": "Add minced garlic, tomato paste, dried oregano, and bay leaves, stirring constantly until highly aromatic."
        },
        {
          "number": 4,
          "step": "Pour in vegetable broth and rinsed lentils, bringing the pot to a rapid boil over medium-high heat."
        },
        {
          "number": 5,
          "step": "Reduce heat to low, cover pot, and simmer gently for thirty-five minutes until lentils become completely tender."
        },
        {
          "number": 6,
          "step": "Stir in red wine vinegar and extra virgin olive oil just before ladling the hot soup into deep bowls."
        }
      ]
    }
