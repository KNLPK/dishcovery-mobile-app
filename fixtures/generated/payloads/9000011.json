  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Whisk together gochujang paste, soy sauce, brown sugar, sesame oil, grated ginger, minced garlic, and pear juice."
        },
        {
          "number": 2,
          "step": "Coat pork belly slices evenly in the sauce, then chill covered in the refrigerator for up to twenty-four hours."
        },
        {
          "number": 3,
          "step": "Preheat oven to four hundred degrees Fahrenheit and line a large rimmed baking sheet with heavy aluminum foil."
        },
        {
          "number": 4,
          "step": "Arrange marinated pork belly in a single layer on the baking sheet, leaving small gaps between each tender slice."
        },
        {
          "number": 5,
          "step": "Roast in the oven for thirty-five minutes, turning once mid-way through until caramelized and crispy on edges."
        },
        {
          "number": 6,
          "step": "Drizzle remaining glaze over hot pork, top with sliced green onions and toasted sesame seeds, then serve hot."
        }
      ]
    }
