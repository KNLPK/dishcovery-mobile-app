      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Slice the smoked pork belly into bite-sized pieces and cook in a skillet over medium heat until golden brown."
        },
        {
          "number": 2,
          "step": "Soak cylindrical rice cakes in warm water for fifteen minutes to soften them prior to assembling the casserole."
        },
        {
          "number": 3,
          "step": "Whisk gochujang paste, soy sauce, minced garlic, sesame oil, and honey together in a bowl until smooth."
        },
        {
          "number": 4,
          "step": "Layer softened rice cakes, smoked pork belly, and chopped kimchi evenly into a greased ceramic baking dish."
        },
        {
          "number": 5,
          "step": "Pour the spiced gochujang mixture over the layered ingredients, topping with a generous layer of mozzarella."
        },
        {
          "number": 6,
          "step": "Bake at three hundred seventy-five degrees Fahrenheit for twenty minutes until cheese bubbles and browns."
        }
      ]
    }
