  "analyzedInstructions": [
    {
      "name": "Marinade and Searing",
      "steps": [
        {
          "number": 1,
          "step": "Trim excess surface fat from lamb shoulder shanks using a sharp butcher knife."
        },
        {
          "number": 2,
          "step": "Mix Lebanese seven spice, sumac, sea salt, black pepper, and olive oil in bowl."
        },
        {
          "number": 3,
          "step": "Rub spice paste thoroughly over all sides of trimmed lamb shanks on large tray."
        },
        {
          "number": 4,
          "step": "Cover spiced lamb shanks with plastic wrap and let marinate twenty minutes."
        },
        {
          "number": 5,
          "step": "Peel whole shallots cleanly leaving them intact for slow festive braise."
        },
        {
          "number": 6,
          "step": "Mince garlic cloves finely and steep saffron threads in two tablespoons warm water."
        },
        {
          "number": 7,
          "step": "Heat clarified butter in a large heavy Dutch oven over medium-high heat."
        },
        {
          "number": 8,
          "step": "Place marinated lamb shanks in Dutch oven and sear eight minutes until deep brown."
        },
        {
          "number": 9,
          "step": "Turn lamb shanks using sturdy tongs to sear all sides evenly to rich color."
        },
        {
          "number": 10,
          "step": "Transfer seared lamb shanks to a warm platter setting aside while building base."
        },
        {
          "number": 11,
          "step": "Add whole peeled shallots and garlic to hot Dutch oven sautéing four minutes."
        },
        {
          "number": 12,
          "step": "Add cinnamon stick and whole cloves stirring until warm spices become fragrant."
        },
        {
          "number": 13,
          "step": "Pour pomegranate molasses into Dutch oven deglazing pan bottom with spatula."
        },
        {
          "number": 14,
          "step": "Pour in lamb stock and steeped saffron liquid stirring base until fully blended."
        }
      ]
    },
    {
      "name": "Celebration Broth Simmer",
      "steps": [
        {
          "number": 1,
          "step": "Return seared lamb shanks to Dutch oven submerging partially in saffron broth."
        },
        {
          "number": 2,
          "step": "Bring braising broth to a boil over high flame then turn heat down to low."
        },
        {
          "number": 3,
          "step": "Cover Dutch oven tightly with heavy lid and simmer gently for ninety minutes."
        },
        {
          "number": 4,
          "step": "Peel butternut squash and cut into neat two-inch chunks on plastic cutting board."
        },
        {
          "number": 5,
          "step": "Stem dried figs and slice in half lengthwise on cutting board ready for pot."
        },
        {
          "number": 6,
          "step": "Rinse cooked chickpeas in strainer under cold tap water and drain completely."
        },
        {
          "number": 7,
          "step": "After ninety minutes uncover Dutch oven and stir in squash, figs, and chickpeas."
        },
        {
          "number": 8,
          "step": "Cover Dutch oven again and simmer twenty more minutes until squash is tender."
        },
        {
          "number": 9,
          "step": "Rinse basmati rice under cold water until water runs clear then drain well."
        },
        {
          "number": 10,
          "step": "Cook basmati rice in saucepan with water and pinch of saffron fifteen minutes."
        },
        {
          "number": 11,
          "step": "Toast pine nuts and slivered almonds in dry skillet until golden and fragrant."
        },
        {
          "number": 12,
          "step": "Chop fresh mint leaves and flat-leaf parsley coarsely on dry cutting board."
        },
        {
          "number": 13,
          "step": "Stir rose water and fresh lemon juice into braising stew liquid right at end."
        },
        {
          "number": 14,
          "step": "Verify lamb shoulder meat is tender and easily yields to gentle pressure of fork."
        }
      ]
    },
    {
      "name": "Final Assembly and Garnish",
      "steps": [
        {
          "number": 1,
          "step": "Remove cinnamon stick and whole cloves from stew pot carefully using tongs."
        },
        {
          "number": 2,
          "step": "Taste celebration stew broth and adjust salt or black pepper to perfection."
        },
        {
          "number": 3,
          "step": "Mound warm golden saffron basmati rice onto center of large festive platter."
        },
        {
          "number": 4,
          "step": "Arrange tender braised lamb shanks on top of warm saffron rice neatly."
        },
        {
          "number": 5,
          "step": "Spoon whole shallots, butternut squash, figs, and chickpeas around lamb base."
        },
        {
          "number": 6,
          "step": "Ladle rich ruby pomegranate stew sauce generously over lamb meat and rice."
        },
        {
          "number": 7,
          "step": "Scatter toasted pine nuts and slivered almonds over entire plated celebration stew."
        },
        {
          "number": 8,
          "step": "Sprinkle bright ruby pomegranate seeds across top for festive jewel accent."
        },
        {
          "number": 9,
          "step": "Garnish dish generously with chopped fresh mint and flat-leaf parsley leaves."
        },
        {
          "number": 10,
          "step": "Dust extra ground sumac around rim of serving platter for decorative touch."
        },
        {
          "number": 11,
          "step": "Check temperature ensuring lamb shanks and rice are steaming hot for feast."
        },
        {
          "number": 12,
          "step": "Present celebration Lebanese lamb stew to guests at center of dining table."
        },
        {
          "number": 13,
          "step": "Serve alongside warm pita bread and extra pomegranate molasses for drizzling."
        },
        {
          "number": 14,
          "step": "Enjoy this rich festive lamb stew surrounded by family and celebration warmth."
        }
      ]
    }
  ]
