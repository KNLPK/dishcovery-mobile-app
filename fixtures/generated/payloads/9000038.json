  "analyzedInstructions": [
    {
      "name": "Flatbread Pan Frying",
      "steps": [
        {
          "number": 1,
          "step": "Mix flour, water, condensed milk, salt, and melted ghee to form a smooth dough, then rest for thirty minutes."
        },
        {
          "number": 2,
          "step": "Sauté minced chicken with yellow curry paste, onions, and coconut cream until cooked through and moisture evaporates."
        },
        {
          "number": 3,
          "step": "Divide the rested dough into four portions and roll each thin onto an oiled surface until nearly translucent."
        },
        {
          "number": 4,
          "step": "Pour a portion of beaten egg and cooked chicken mixture into the center of each stretched dough sheet."
        },
        {
          "number": 5,
          "step": "Fold the edges over the filling to create a sealed square packet, pressing edges gently to prevent leaks."
        },
        {
          "number": 6,
          "step": "Pan fry the stuffed roti in melted ghee over medium heat for three minutes per side until golden brown."
        }
      ]
    }
  ]
