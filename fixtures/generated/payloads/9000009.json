  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Pat the beef short ribs dry with paper towels and season generously on all sides with sea salt and freshly cracked pepper."
        },
        {
          "number": 2,
          "step": "Heat olive oil in a heavy pressure cooker over medium-high heat until shimmer occurs, then sear the ribs until browned."
        },
        {
          "number": 3,
          "step": "Remove the ribs and sauté peeled shallots, sliced carrots, and minced garlic in the pot for four minutes until fragrant."
        },
        {
          "number": 4,
          "step": "Stir in the tomato paste and deglaze the hot pot with red wine, scraping up any browned bits stuck to the bottom surface."
        },
        {
          "number": 5,
          "step": "Return the short ribs, pour in beef broth along with thyme sprigs, seal the lid, and braise on high pressure for thirty minutes."
        },
        {
          "number": 6,
          "step": "Release pressure naturally, transfer meat to a platter, stir butter into the rich reduced pan sauce, and spoon over the beef."
        }
      ]
    }
