  "analyzedInstructions": [
    {
      "name": "Roasting Process",
      "steps": [
        {
          "number": 1,
          "step": "Preheat your oven to four hundred degrees Fahrenheit and line a large heavy baking sheet with parchment paper."
        },
        {
          "number": 2,
          "step": "Cut the calabaza pumpkin into six equal wedges, removing the seeds and inner stringy pulp completely."
        },
        {
          "number": 3,
          "step": "Melt piloncillo with butter, honey, vanilla extract, and orange zest in a small saucepan over low heat."
        },
        {
          "number": 4,
          "step": "Arrange pumpkin wedges on the baking sheet and brush all exposed surfaces thoroughly with spiced honey glaze."
        },
        {
          "number": 5,
          "step": "Scatter whole cinnamon sticks and star anise over the pan, then roast for thirty-five minutes until tender."
        },
        {
          "number": 6,
          "step": "Transfer roasted pumpkin to dessert plates, drizzling warm cajeta caramel and pepitas over top to finish."
        }
      ]
    }
