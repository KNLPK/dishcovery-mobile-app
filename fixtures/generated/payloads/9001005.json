  "analyzedInstructions": [
    {
      "name": "Paste and Fruit Prep",
      "steps": [
        {
          "number": 1,
          "step": "Soak eight bamboo skewers in warm water thirty minutes to prevent burning on grill."
        },
        {
          "number": 2,
          "step": "Peel ripe plantains carefully and slice into thick one-inch round chunks on board."
        },
        {
          "number": 3,
          "step": "Mix grated cassava, tapioca starch, rice flour, and pinch of salt in medium bowl."
        },
        {
          "number": 4,
          "step": "Add fifty milliliters coconut cream and vanilla extract into cassava starch mixture."
        },
        {
          "number": 5,
          "step": "Knead dough by hand until smooth soft paste forms that clings together easily."
        },
        {
          "number": 6,
          "step": "Wrap each plantain chunk in a thin layer of cassava paste pressing securely."
        },
        {
          "number": 7,
          "step": "Tie fresh pandan leaves into tight knot and bruise with knife handle to release oils."
        },
        {
          "number": 8,
          "step": "Combine wildflower honey, palm sugar, water, and bruised pandan in small pot."
        },
        {
          "number": 9,
          "step": "Simmer honey mixture over low flame five minutes until sugar dissolves completely."
        },
        {
          "number": 10,
          "step": "Stir remaining coconut cream and pandan extract into honey glaze until smooth."
        }
      ]
    },
    {
      "name": "Skewering",
      "steps": [
        {
          "number": 1,
          "step": "Remove soaked bamboo skewers from water bath and pat dry with clean paper towel."
        },
        {
          "number": 2,
          "step": "Thread three paste-wrapped plantain pieces securely onto each wooden skewer."
        },
        {
          "number": 3,
          "step": "Leave short open handle space at bottom of each skewer for easy grill turning."
        },
        {
          "number": 4,
          "step": "Lightly brush paste-wrapped fruit skewers with neutral cooking oil on all sides."
        },
        {
          "number": 5,
          "step": "Dust skewers lightly with powdered sugar to promote rapid golden caramelization."
        },
        {
          "number": 6,
          "step": "Coarsely crush roasted peanuts using a pestle and mortar on clean kitchen counter."
        },
        {
          "number": 7,
          "step": "Toast white sesame seeds in a dry pan over low heat until pale golden and fragrant."
        },
        {
          "number": 8,
          "step": "Finely mince crystallized ginger and mix into crushed peanuts in a small dish."
        },
        {
          "number": 9,
          "step": "Slice lime into four bright wedges ready for squeezing over finished dessert."
        },
        {
          "number": 10,
          "step": "Pick fresh mint leaves from stems and wash in cold water then pat dry completely."
        }
      ]
    },
    {
      "name": "Grilling and Glazing",
      "steps": [
        {
          "number": 1,
          "step": "Preheat indoor cast iron grill pan or outdoor grill grates to high temperature."
        },
        {
          "number": 2,
          "step": "Oil grill grates lightly using a rolled paper towel dipped in coconut oil."
        },
        {
          "number": 3,
          "step": "Place prepared plantain skewers directly onto hot grill grates in single layer."
        },
        {
          "number": 4,
          "step": "Grill skewers three minutes until dark golden char marks appear on bottom side."
        },
        {
          "number": 5,
          "step": "Turn skewers using metal tongs and brush top side generously with pandan honey glaze."
        },
        {
          "number": 6,
          "step": "Grill second side three minutes brushing continuously with warm coconut pandan glaze."
        },
        {
          "number": 7,
          "step": "Rotate skewers to char sides evenly while basting with glaze on every turn."
        },
        {
          "number": 8,
          "step": "Ensure cassava coating becomes crisp and caramelized while fruit grows soft."
        },
        {
          "number": 9,
          "step": "Remove pandan knot from remaining glaze and stir in small drizzle condensed milk."
        },
        {
          "number": 10,
          "step": "Transfer charred skewers carefully from grill to clean rimmed tray for final sauce."
        }
      ]
    },
    {
      "name": "Plating and Toppings",
      "steps": [
        {
          "number": 1,
          "step": "Spoon warm remaining pandan honey glaze across bottom of four serving dessert plates."
        },
        {
          "number": 2,
          "step": "Arrange two warm grilled banana skewers neatly on top of glaze on each plate."
        },
        {
          "number": 3,
          "step": "Sprinkle crushed roasted peanuts and ginger mixture generously over skewers."
        },
        {
          "number": 4,
          "step": "Scatter toasted white sesame seeds across sticky glaze for crisp texture contrast."
        },
        {
          "number": 5,
          "step": "Top skewers with toasted coconut flakes for light tropical aroma and appearance."
        },
        {
          "number": 6,
          "step": "Garnish plate edge with fresh mint leaves and a bright fresh lime wedge slice."
        },
        {
          "number": 7,
          "step": "Dust a tiny pinch ground cinnamon over coconut flakes right before serving plates."
        },
        {
          "number": 8,
          "step": "Verify plantain skewers are hot sticky caramelized and appealingly fragrant."
        },
        {
          "number": 9,
          "step": "Serve Vietnamese dessert skewers immediately with extra pandan honey glaze side."
        },
        {
          "number": 10,
          "step": "Instruct guests to squeeze lime wedge over skewers to balance rich sweetness."
        }
      ]
    }
  ]
}
