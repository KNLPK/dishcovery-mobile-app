      "steps": [
        {
          "number": 1,
          "step": "Heat a heavy skillet over medium flame and cook the seasoned ground pork until golden and completely browned throughout."
        },
        {
          "number": 2,
          "step": "Add the chopped bell peppers and crushed garlic into the hot pan drippings, cooking until tender for four minutes."
        },
        {
          "number": 3,
          "step": "Remove the meat mixture from the skillet and wipe away excess grease using a dry paper towel while keeping heat low."
        },
        {
          "number": 4,
          "step": "Sift the hydrated cassava starch across the bottom of the warm skillet in a uniform layer without adding extra fat."
        },
        {
          "number": 5,
          "step": "Spread the reserved meat, shredded canastra cheese, and chopped cilantro over one half of the fusing cassava dough layer."
        },
        {
          "number": 6,
          "step": "Fold the flatbread in half, searing each side for two minutes until the cheese melts into a warm golden crisp crust."
        }
      ]
    }
