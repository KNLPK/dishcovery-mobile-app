      "steps": [
        {
          "number": 1,
          "step": "Rinse coarse freekeh under cold water, simmer in pot with water for twenty minutes until tender, then cool."
        },
        {
          "number": 2,
          "step": "Finely chop fresh parsley leaves and mint leaves, placing them into a large salad mixing bowl."
        },
        {
          "number": 3,
          "step": "Dice cucumber and quarter cherry tomatoes, then add them into the bowl with herbs and pomegranate seeds."
        },
        {
          "number": 4,
          "step": "Toast chopped walnuts in a dry skillet over medium heat for four minutes until fragrant and golden brown."
        },
        {
          "number": 5,
          "step": "Whisk extra virgin olive oil, lemon juice, sumac spice, and sea salt together in a small pitcher."
        },
        {
          "number": 6,
          "step": "Combine cooled freekeh with vegetables, pour dressing over salad, toss thoroughly, and top with walnuts."
        }
      ]
