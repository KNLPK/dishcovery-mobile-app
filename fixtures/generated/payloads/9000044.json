  "analyzedInstructions": [
    {
      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Heat ghee in a heavy dutch oven and cook diced onions until deeply caramelised and golden brown around the edges."
        },
        {
          "number": 2,
          "step": "Add minced garlic, freshly grated ginger, cumin seeds, and turmeric, stirring rapidly until fragrant spices bloom in oil."
        },
        {
          "number": 3,
          "step": "Rinse red lentils under cool water until the rinse water runs clear, then add them directly into the Dutch oven pot."
        },
        {
          "number": 4,
          "step": "Pour in crushed tomatoes and vegetable broth, stirring well to scrape up any flavorful browned bits stuck to the bottom."
        },
        {
          "number": 5,
          "step": "Bring the soup to a gentle boil, lower heat, cover, and simmer for twenty minutes until red lentils become soft and creamy."
        },
        {
          "number": 6,
          "step": "Finish the soup by stirring in fresh lemon juice and chopped cilantro, then ladle generously into deep warm bowls."
        }
      ]
    }
