  "analyzedInstructions": [
    {
      "name": "Broth Infusion",
      "steps": [
        {
          "number": 1,
          "step": "Finely dice yellow onion and garlic cloves on a clean plastic cutting board."
        },
        {
          "number": 2,
          "step": "Heat olive oil and butter in a heavy soup pot over medium heat until melting."
        },
        {
          "number": 3,
          "step": "Sauté diced onions and garlic with dried oregano three minutes until soft."
        },
        {
          "number": 4,
          "step": "Pour chicken stock into pot and add whole lemon zest strip and bay leaf."
        },
        {
          "number": 5,
          "step": "Bring stock mixture to a boil over high heat then turn flame down to low."
        },
        {
          "number": 6,
          "step": "Rinse short-grain rice under cold water in a mesh strainer until water runs clear."
        },
        {
          "number": 7,
          "step": "Add rinsed short-grain rice into simmering chicken stock stirring gently once."
        },
        {
          "number": 8,
          "step": "Cover soup pot with lid and simmer fifteen minutes until rice is tender."
        },
        {
          "number": 9,
          "step": "Remove bay leaf and lemon zest strip from pot with slotted spoon and discard."
        },
        {
          "number": 10,
          "step": "Season simmering rice broth with half teaspoon sea salt and black pepper."
        },
        {
          "number": 11,
          "step": "Reduce heat under soup pot to absolute minimum to hold gentle low heat."
        },
        {
          "number": 12,
          "step": "Coarsely crush barley rusks into bite-sized pieces using hands over bowl."
        },
        {
          "number": 13,
          "step": "Chop fresh dill, parsley, and scallions finely on cutting board for garnish."
        },
        {
          "number": 14,
          "step": "Crumble feta cheese into small chunks in a glass ramekin bowl for topping."
        }
      ]
    },
    {
      "name": "Egg and Lemon Tempering",
      "steps": [
        {
          "number": 1,
          "step": "Separate egg yolks from whites cleanly putting four yolks into a glass bowl."
        },
        {
          "number": 2,
          "step": "Pour fresh lemon juice into egg yolk bowl whisking vigorously until frothy."
        },
        {
          "number": 3,
          "step": "Ladle one cup of hot rice broth from pot slowly into whisked egg yolk mixture."
        },
        {
          "number": 4,
          "step": "Whisk egg yolks continuously while pouring hot broth to temper without curdling."
        },
        {
          "number": 5,
          "step": "Ladle a second cup of hot broth into egg mixture while whisking constantly."
        },
        {
          "number": 6,
          "step": "Pour tempered egg lemon liquid slowly back into main soup pot while stirring."
        },
        {
          "number": 7,
          "step": "Stir soup constantly over low heat for three minutes until silky smooth broth thickens."
        },
        {
          "number": 8,
          "step": "Do not allow soup to boil after adding eggs to keep silky smooth texture."
        },
        {
          "number": 9,
          "step": "Fill a separate shallow saucepan with water, white vinegar, and pinch of salt."
        },
        {
          "number": 10,
          "step": "Bring poaching water to bare simmer creating tiny bubbles along pan bottom."
        },
        {
          "number": 11,
          "step": "Crack whole eggs one at a time into small ramekin cups for easy sliding."
        },
        {
          "number": 12,
          "step": "Swirl poaching water to create whirlpool then slide eggs gently into center."
        },
        {
          "number": 13,
          "step": "Poach whole eggs three minutes until whites set but yolks remain soft inside."
        },
        {
          "number": 14,
          "step": "Lift poached eggs with slotted spoon onto paper towel lined plate carefully."
        }
      ]
    },
    {
      "name": "Morning Assembly",
      "steps": [
        {
          "number": 1,
          "step": "Divide crushed barley rusks evenly into four warm breakfast soup bowls."
        },
        {
          "number": 2,
          "step": "Ladle velvety lemon egg soup and cooked rice over barley rusks in each bowl."
        },
        {
          "number": 3,
          "step": "Gently place one poached egg right in center of each filled breakfast bowl."
        },
        {
          "number": 4,
          "step": "Scatter crumbled feta cheese around poached egg in each serving portion."
        },
        {
          "number": 5,
          "step": "Sprinkle chopped fresh dill, parsley, and sliced scallions across soup surface."
        },
        {
          "number": 6,
          "step": "Add capers and a dash of capers liquid to each bowl for bright salinity."
        },
        {
          "number": 7,
          "step": "Dust top with cracked black pepper and tiny pinch of cayenne pepper spice."
        },
        {
          "number": 8,
          "step": "Drizzle extra virgin olive oil over soup surface for glossy rich finish."
        },
        {
          "number": 9,
          "step": "Finish each bowl with a light sprinkle of sea salt flakes over poached egg."
        },
        {
          "number": 10,
          "step": "Verify poached eggs are warm and soup consistency is rich and velvety cream."
        },
        {
          "number": 11,
          "step": "Serve immediately while steaming hot for an energizing Greek breakfast bowl."
        },
        {
          "number": 12,
          "step": "Instruct diners to break poached yolk into lemon broth before eating soup."
        },
        {
          "number": 13,
          "step": "Provide extra lemon wedges on side for guests wanting additional tart zip."
        },
        {
          "number": 14,
          "step": "Enjoy this nourishing egg and lemon breakfast soup start to your morning."
        }
      ]
    }
  ]
}
