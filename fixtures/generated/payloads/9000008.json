    {
      "name": "Bake Preparation",
      "steps": [
        {
          "number": 1,
          "step": "Soak rice cakes in warm water for 15 minutes to soften, then drain thoroughly before assembling."
        },
        {
          "number": 2,
          "step": "Whisk gochujang paste, rice syrup, soy sauce, minced garlic, and sesame oil together in a bowl."
        },
        {
          "number": 3,
          "step": "Layer sliced napa cabbage and chopped green onions across the bottom of a greased ovenproof baking dish."
        },
        {
          "number": 4,
          "step": "Arrange softened rice cakes, squid rings, and peeled shrimp in an even layer over the vegetables."
        },
        {
          "number": 5,
          "step": "Pour the prepared gochujang sauce evenly over the seafood and cover the baking dish with foil."
        },
        {
          "number": 6,
          "step": "Bake at 200 degrees Celsius for 20 minutes, uncover, sprinkle with mozzarella, and bake five minutes more."
        }
      ]
