  "analyzedInstructions": [
    {
      "name": "Preparation",
      "steps": [
        {
          "number": 1,
          "step": "Soak wooden skewers in cool water for twenty minutes to prevent them from burning during high heat grilling."
        },
        {
          "number": 2,
          "step": "Cut the cheese, hearts of palm, and yellow bell pepper into uniform two inch cubes for even cooking."
        },
        {
          "number": 3,
          "step": "Whisk olive oil, lime juice, garlic powder, dried oregano, salt, and black pepper together in a large bowl."
        },
        {
          "number": 4,
          "step": "Thread alternating pieces of cheese, hearts of palm, bell pepper, and cherry tomatoes onto each prepared skewer."
        },
        {
          "number": 5,
          "step": "Brush the marinade generously over all sides of the skewers to ensure complete coverage before cooking."
        },
        {
          "number": 6,
          "step": "Grill over medium heat for eight minutes, turning regularly until the cheese turns golden brown and blistered."
        }
      ]
    }
  ]
