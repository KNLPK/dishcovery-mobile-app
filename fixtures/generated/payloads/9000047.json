      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Warm olive oil in a heavy clay tagine base and cook chopped red onions until soft, translucent, and fragrant."
        },
        {
          "number": 2,
          "step": "Add ras el hanout, ground cinnamon, ginger, and minced garlic, stirring for one minute to bloom aromatic spices."
        },
        {
          "number": 3,
          "step": "Toss in diced butternut squash, chopped zucchini, dried apricots, cooked chickpeas, and canned crushed tomatoes."
        },
        {
          "number": 4,
          "step": "Pour in vegetable stock to submerge vegetables, stir gently, bring to a simmer, and cover with conical tagine lid."
        },
        {
          "number": 5,
          "step": "Simmer gently over low heat for forty minutes until butternut squash becomes fork tender and liquid reduces."
        },
        {
          "number": 6,
          "step": "Garnish stew with toasted flaked almonds and fresh cilantro, serving hot over warm fluffy couscous grains."
        }
      ]
    }
