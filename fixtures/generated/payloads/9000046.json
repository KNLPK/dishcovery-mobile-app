      "name": "",
      "steps": [
        {
          "number": 1,
          "step": "Fry thick smoked bacon lardons in a Dutch oven over medium heat until crispy and fat is fully rendered out."
        },
        {
          "number": 2,
          "step": "Pat beef chuck cubes completely dry, season with salt, and sear in rendered bacon fat until deeply browned on all sides."
        },
        {
          "number": 3,
          "step": "Sauté sliced carrots, pearl onions, and garlic cloves in remaining pot drippings until soft and lightly browned."
        },
        {
          "number": 4,
          "step": "Stir in tomato paste and flour, cooking for two minutes before deglazing the Dutch oven with rich red burgundy wine."
        },
        {
          "number": 5,
          "step": "Return beef and bacon to pot with fresh thyme and beef stock, cover tightly, and braise in oven at low heat for three hours."
        },
        {
          "number": 6,
          "step": "Skim off excess surface fat, season gravy with black pepper, and serve hot over buttery parsley potatoes."
        }
      ]
    }
