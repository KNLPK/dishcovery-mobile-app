il\"},{\"amount\":3,\"unit\":\"cloves\",\"name\":\"fresh garlic\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"fresh rosemary\"},{\"amount\":1,\"unit\":\"tsp\",\"name\":\"dried oregano\"},{\"amount\":0.5,\"unit\":\"tsp\",\"name\":\"sea salt\"},{\"amount\":0.25,\"unit\":\"tsp\",\"name\":\"black pepper\"},{\"amount\":0.5,\"unit\":\"cup\",\"name\":\"dry white wine\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"lemon juice\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"unsalted butter\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"fresh parsley\"}],\"analyzedInstructions\":[{\"name\":\"\",\"steps\":[{\"number\":1,\"step\":\"Preheat your oven to 425 degrees Fahrenheit and pat the pork tenderloin completely dry using clean paper towels.\"},{\"number\":2,\"step\":\"Mix minced garlic, chopped fresh rosemary, dried oregano, salt, black pepper, and olive oil together in a small bowl.\"},{\"number\":3,\"step\":\"Rub the herb and oil mixture evenly over all sides of the pork tenderloin until it is thoroughly coated with flavor.\"},{\"number\":4,\"step\":\"Sear the pork in an oven-safe skillet over medium-high heat for two minutes per side until a golden brown crust forms.\"},{\"number\":5,\"step\":\"Transfer the skillet to the preheated oven and roast for fifteen minutes until the internal temperature reaches 145 degrees.\"},{\"number\":6,\"step\":\"Remove the pork to rest, then deglaze the skillet with white wine, lemon juice, butter, and chopped fresh parsley.\"}]}]}",
