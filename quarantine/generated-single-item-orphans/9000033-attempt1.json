nit\":\"lb\",\"name\":\"pork shoulder\"},{\"amount\":3,\"unit\":\"tbsp\",\"name\":\"achiote paste\"},{\"amount\":0.75,\"unit\":\"cup\",\"name\":\"orange juice\"},{\"amount\":0.25,\"unit\":\"cup\",\"name\":\"lime juice\"},{\"amount\":4,\"unit\":\"\",\"name\":\"dried guajillo chiles\"},{\"amount\":6,\"unit\":\"cloves\",\"name\":\"garlic\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"ground cumin\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"dried oregano\"},{\"amount\":2,\"unit\":\"tbsp\",\"name\":\"apple cider vinegar\"},{\"amount\":1.5,\"unit\":\"tsp\",\"name\":\"coarse sea salt\"},{\"amount\":1,\"unit\":\"cup\",\"name\":\"chicken broth\"}],\"analyzedInstructions\":[{\"name\":\"Preparation and Roasting\",\"steps\":[{\"number\":1,\"step\":\"Toast the dried guajillo chiles in a dry skillet over medium heat for two minutes until fragrant, then soak in hot water.\"},{\"number\":2,\"step\":\"Blend the soaked chiles with achiote paste, orange juice, lime juice, garlic, cumin, oregano, vinegar, and salt until smooth.\"},{\"number\":3,\"step\":\"Score the pork shoulder and rub the marinade completely over all sides, then cover and refrigerate overnight for best flavor.\"},{\"number\":4,\"step\":\"Place the marinated pork into a heavy Dutch oven, pour in chicken broth, cover tightly, and roast at 325°F for three hours.\"},{\"number\":5,\"step\":\"Uncover the pot and roast for another thirty minutes until the exterior is nicely browned and the meat shreds easily with a fork.\"},{\"number\":6,\"step\":\"Transfer the roast to a warm platter, skim fat from the braising liquid, and pour the rich pan juices back over the shredded meat.\"}]}]}",
