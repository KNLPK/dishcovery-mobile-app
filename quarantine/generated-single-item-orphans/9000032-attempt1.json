so paste\"},{\"amount\":3,\"unit\":\"tbsp\",\"name\":\"dark soy sauce\"},{\"amount\":2,\"unit\":\"tbsp\",\"name\":\"hon mirin\"},{\"amount\":0.25,\"unit\":\"cup\",\"name\":\"junmai sake\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"fresh ginger\"},{\"amount\":3,\"unit\":\"cloves\",\"name\":\"garlic cloves\"},{\"amount\":2,\"unit\":\"tbsp\",\"name\":\"red plum preserve\"},{\"amount\":1,\"unit\":\"tsp\",\"name\":\"toasted sesame oil\"},{\"amount\":4,\"unit\":\"stalks\",\"name\":\"scallions\"},{\"amount\":1,\"unit\":\"tsp\",\"name\":\"sea salt\"}],\"analyzedInstructions\":[{\"name\":\"Preparation and Marinade\",\"steps\":[{\"number\":1,\"step\":\"Score the duck skin in a crosshatch pattern and rub with salt, grated ginger, and a splash of ceremonial sake.\"},{\"number\":2,\"step\":\"Mix miso paste, mirin, soy sauce, and red plum preserve in a bowl until smooth, then coat duck thoroughly.\"}]},{\"name\":\"Roasting and Glazing\",\"steps\":[{\"number\":1,\"step\":\"Roast the duck on a rack set inside a pan at 190°C for 50 minutes, basting occasionally with pan juices.\"},{\"number\":2,\"step\":\"Brush remaining sake glaze over the skin and broil for 5 minutes until crispy and deep mahogany in color.\"}]}]}",
