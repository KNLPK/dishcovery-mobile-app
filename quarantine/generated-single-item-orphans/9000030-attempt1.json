\":\"full-fat coconut milk\"},{\"amount\":200,\"unit\":\"ml\",\"name\":\"condensed milk\"},{\"amount\":100,\"unit\":\"g\",\"name\":\"grated coconut\"},{\"amount\":50,\"unit\":\"g\",\"name\":\"unprocessed brown sugar\"},{\"amount\":2,\"unit\":\"tbsp\",\"name\":\"unsalted butter\"},{\"amount\":1,\"unit\":\"tsp\",\"name\":\"ground cinnamon\"},{\"amount\":0.5,\"unit\":\"tsp\",\"name\":\"ground cloves\"},{\"amount\":1,\"unit\":\"pinch\",\"name\":\"fine sea salt\"},{\"amount\":1,\"unit\":\"tsp\",\"name\":\"vanilla extract\"},{\"amount\":2,\"unit\":\"tbsp\",\"name\":\"toasted cashew nuts\"}],\"analyzedInstructions\":[{\"name\":\"\",\"steps\":[{\"number\":1,\"step\":\"Peel the cassava roots thoroughly, chop them into small uniform cubes, and remove any fibrous woody core pieces before starting.\"},{\"number\":2,\"step\":\"Place the prepared cassava cubes into a heavy saucepan, cover completely with water, and simmer until tender for about twenty minutes.\"},{\"number\":3,\"step\":\"Drain the softened cassava thoroughly, returning the warm cooked pieces back into the pot over low heat to allow excess moisture to evaporate.\"},{\"number\":4,\"step\":\"Pour in full-fat coconut milk, sweetened condensed milk, brown sugar, butter, salt, cinnamon, and cloves while gently stirring the mixture.\"},{\"number\":5,\"step\":\"Simmer the sweet stew over medium-low heat for ten minutes until the liquids thicken into a rich cream that coats the cassava pieces.\"},{\"number\":6,\"step\":\"Remove from heat, stir in vanilla extract, fold in grated coconut, and spoon into dessert bowls topped with crisp toasted cashew nuts.\"}]}]}",
