{\"amount\":2.0,\"unit\":\"tbsp\",\"name\":\"olive oil\"},{\"amount\":1.0,\"unit\":\"large\",\"name\":\"yellow onion\"},{\"amount\":4.0,\"unit\":\"cloves\",\"name\":\"garlic\"},{\"amount\":1.0,\"unit\":\"large\",\"name\":\"eggplant\"},{\"amount\":2.0,\"unit\":\"cans\",\"name\":\"chickpeas\"},{\"amount\":14.0,\"unit\":\"oz\",\"name\":\"diced tomatoes\"},{\"amount\":1.0,\"unit\":\"tsp\",\"name\":\"ground cumin\"},{\"amount\":1.0,\"unit\":\"tsp\",\"name\":\"ground coriander\"},{\"amount\":0.5,\"unit\":\"tsp\",\"name\":\"ground cinnamon\"},{\"amount\":1.0,\"unit\":\"tsp\",\"name\":\"salt\"},{\"amount\":0.25,\"unit\":\"cup\",\"name\":\"fresh mint leaves\"}],\"analyzedInstructions\":[{\"name\":\"\",\"steps\":[{\"number\":1,\"step\":\"Heat the olive oil in a large Dutch oven over medium heat, then add chopped onion and garlic, cooking until soft.\"},{\"number\":2,\"step\":\"Add diced eggplant to the pot and sauté for about eight minutes until the pieces soften and brown slightly around edges.\"},{\"number\":3,\"step\":\"Stir in the ground cumin, ground coriander, cinnamon, and salt, allowing the aromatic spices to toast for one minute.\"},{\"number\":4,\"step\":\"Pour in the diced tomatoes with their juices along with rinsed chickpeas, stirring gently to combine all ingredients.\"},{\"number\":5,\"step\":\"Reduce heat to low, cover the pot with a lid, and simmer for twenty minutes until the sauce thickens and flavors meld.\"},{\"number\":6,\"step\":\"Remove the pot from heat, stir in fresh chopped mint leaves, and allow the stew to rest five minutes before serving hot.\"}]}]}",
