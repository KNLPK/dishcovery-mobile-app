\":400,\"unit\":\"ml\",\"name\":\"coconut milk\"},{\"amount\":250,\"unit\":\"ml\",\"name\":\"jasmine water\"},{\"amount\":3,\"unit\":\"stems\",\"name\":\"pandan leaves\"},{\"amount\":120,\"unit\":\"g\",\"name\":\"palm sugar\"},{\"amount\":50,\"unit\":\"g\",\"name\":\"small tapioca pearls\"},{\"amount\":0.5,\"unit\":\"tsp\",\"name\":\"sea salt\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"toasted sesame seeds\"},{\"amount\":100,\"unit\":\"ml\",\"name\":\"coconut cream\"},{\"amount\":80,\"unit\":\"g\",\"name\":\"young coconut meat\"},{\"amount\":1,\"unit\":\"tbsp\",\"name\":\"rice flour\"}],\"analyzedInstructions\":[{\"name\":\"\",\"steps\":[{\"number\":1,\"step\":\"Peel the fresh taro root carefully, then cut it into bite-sized three-quarter inch cubes and rinse under cold tap water.\"},{\"number\":2,\"step\":\"In a medium heavy-bottomed pot, combine coconut milk, jasmine water, and tied pandan leaves over medium-low heat.\"},{\"number\":3,\"step\":\"Add the cubed taro root and palm sugar, slowly bringing the mixture to a gentle simmer while stirring occasionally.\"},{\"number\":4,\"step\":\"Reduce the heat to low and cook gently for twenty minutes until the taro chunks become tender when pierced with a fork.\"},{\"number\":5,\"step\":\"Stir in small tapioca pearls and sea salt, continuing to simmer until the pearls turn completely translucent and soft.\"},{\"number\":6,\"step\":\"Remove the pandan leaves, ladle the warm sweet stew into individual dessert bowls, and garnish with toasted sesame seeds.\"}]}]}",
