\"name\":\"chuck roast beef\"},{\"amount\":2.0,\"unit\":\"tbsp\",\"name\":\"olive oil\"},{\"amount\":6.0,\"unit\":\"medium\",\"name\":\"shallots\"},{\"amount\":4.0,\"unit\":\"cloves\",\"name\":\"garlic\"},{\"amount\":400.0,\"unit\":\"g\",\"name\":\"artichoke hearts\"},{\"amount\":300.0,\"unit\":\"g\",\"name\":\"fingerling potatoes\"},{\"amount\":500.0,\"unit\":\"ml\",\"name\":\"beef broth\"},{\"amount\":3.0,\"unit\":\"tbsp\",\"name\":\"fresh lemon juice\"},{\"amount\":0.25,\"unit\":\"cup\",\"name\":\"fresh dill\"},{\"amount\":1.0,\"unit\":\"tsp\",\"name\":\"dried oregano\"},{\"amount\":1.0,\"unit\":\"tsp\",\"name\":\"salt and black pepper\"}],\"analyzedInstructions\":[{\"name\":\"\",\"steps\":[{\"number\":1,\"step\":\"Heat the olive oil in a heavy Dutch oven over medium-high heat until shimmeringly hot, then season the beef chunks generously with salt.\"},{\"number\":2,\"step\":\"Sear the beef in batches for five minutes until browned on all sides, then transfer the meat to a side plate using a slotted spoon.\"},{\"number\":3,\"step\":\"Add sliced shallots and minced garlic to the residual oil, sautéing for three minutes until fragrant and slightly softened.\"},{\"number\":4,\"step\":\"Pour in the beef broth and dried oregano, scraping up any browned bits from the bottom before returning the beef to the pot.\"},{\"number\":5,\"step\":\"Add halved potatoes and artichoke hearts, bring to a simmer, then cover and cook over low heat for forty-five minutes until tender.\"},{\"number\":6,\"step\":\"Stir in the fresh lemon juice and chopped dill right before serving warm alongside crusty bread for a complete Greek meal.\"}]}]}",
